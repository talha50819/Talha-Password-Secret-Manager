# Rust build artifacts
/target/
crates/*/target/
apps/*/target/

# Tauri auto-generated (regenerated by `cargo tauri build`/`dev`, not hand-authored)
apps/*/gen/

# Never commit an actual vault, audit log, keyfile, or backup produced while testing locally
*.vkl
*.audit.log
*.lock
!Cargo.lock
*.pem
*.key

# Editor/OS cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
