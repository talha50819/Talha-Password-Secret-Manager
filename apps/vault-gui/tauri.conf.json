{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vaultkeep",
  "version": "0.1.0",
  "identifier": "com.vaultkeep.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vaultkeep",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
